    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "vite": "5.4.8",
    "vitest": "2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
