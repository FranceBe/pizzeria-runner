{
  "name": "forno-lento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "npm --prefix server run dev",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/shrikhand": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix"
  }
}
