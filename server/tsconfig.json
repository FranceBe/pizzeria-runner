{
  // The multiplayer server (a Cloudflare Worker), as strict as the game. Its tests are checked with the game's
  // (root tsconfig.json), where vitest's types live.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "../src/multiplayer/protocol.ts"],
  "exclude": ["src/**/*.test.ts"]
}
